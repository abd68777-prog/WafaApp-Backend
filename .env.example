APP_NAME="Loyalty Cards API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Frontend (separate project) — used for CORS + Sanctum stateful domains.
# Comma separated for multiple origins. No trailing slash.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173

# ---------------------------------------------------------------------------
# Clerk — merchant app and admin dashboard sign-in.
# CLERK_JWT_KEY: Clerk Dashboard → API keys → "JWT public key" (PEM), on one
# line with \n in place of each line break.
# CLERK_AUTHORIZED_PARTIES: comma-separated web origins allowed to send Clerk
# tokens (the admin dashboard). Native app tokens carry no origin and are
# accepted without this check.
# CLERK_SECRET_KEY: Clerk Dashboard → API keys → "Secret key" (sk_test_…).
# Only `php artisan clerk:smoke-test` uses it; leave it empty elsewhere and
# never share it with the frontend.
# CLERK_WEBHOOK_SECRET: Clerk Dashboard → Webhooks → your endpoint → Signing
# secret (whsec_…), for POST /api/v1/webhooks/clerk.
# ---------------------------------------------------------------------------
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Platform owner linked to admin access by `php artisan db:seed` (AdminUserSeeder).
# ADMIN_CLERK_USER_ID is the "user_…" id from Clerk Dashboard → Users.
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=
ADMIN_CLERK_USER_ID=

# ---------------------------------------------------------------------------
# Customer login codes (WhatsApp via LightOTP).
# Keep OTP_DRIVER=log locally: the code is written to storage/logs/laravel.log
# instead of being sent, so no credits are spent. Switch to "lightotp" once an
# API key with credit is available.
# ---------------------------------------------------------------------------
OTP_DRIVER=log
LIGHTOTP_API_KEY=
LIGHTOTP_BASE_URL=https://api.lightotp.com
LIGHTOTP_LANGUAGE=ar

# Store review account: Apple and Google reviewers sign in with this number and
# this fixed code (6 digits), written in the review notes. Nothing is sent for
# it and no other number accepts the code. Leave both empty to switch it off.
# Seed its demo cards with `php artisan db:seed --class=ReviewAccountSeeder`.
REVIEW_PHONE=
REVIEW_OTP_CODE=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loyalty_cards
DB_USERNAME=root
DB_PASSWORD=

# Stateless API: no server-side sessions needed for token auth.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@loyalty-cards.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
